{
  "name": "expo-template",
  "androidVersion": "1.0.0",
  "androidVersionCode": 1,
  "iosVersion": "1.0.0",
  "iosBuildNumber": 1,
  "private": true,
  "main": "index.js",
  "author": {
    "name": "hoanggbao",
    "email": "hoanggbao00@gmail.com",
    "url": "https://github.com/hoanggbao00"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "prebuild:android": "expo prebuild --platform android --no-clean",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --platform ios --no-clean",
    "android": "bun scripts/run-android.ts",
    "adb:reverse": "bun scripts/adb-reverse.ts",
    "android:dev": "bun scripts/run-android.ts -v dev",
    "android:preview": "bun scripts/run-android.ts -v preview",
    "android:prod": "bun scripts/run-android.ts -v prod",
    "ios": "bun scripts/run-ios.ts",
    "ios:dev": "bun scripts/run-ios.ts -v dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:ui": "jest",
    "prepare": "lefthook install",
    "build:android": "NODE_ENV=production bun scripts/build-android.ts",
    "build:android:clean": "NODE_ENV=production bun scripts/build-android.ts --clean",
    "build:apk": "NODE_ENV=production bun scripts/build-android.ts -f apk",
    "build:aab": "NODE_ENV=production bun scripts/build-android.ts -f aab",
    "atlas": "EXPO_ATLAS=true bun expo export --platform android && bunx expo-atlas .expo/atlas.jsonl"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~58.0.27",
    "@rbayuokt/expo-adaptive-status-bar": "0.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "5.106.1",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-system-ui": "~58.0.7",
    "i18next": "26.7.1",
    "panelui-native": "1.1.0",
    "react": "19.3.1",
    "react-i18next": "17.1.12",
    "react-native": "0.88.1",
    "react-native-ease": "^0.9.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nano-icons": "^1.0.1",
    "react-native-nitro-fetch": "1.10.0",
    "react-native-nitro-modules": "0.37.2",
    "react-native-plain-text": "0.9.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "4.3.4",
    "uniwind": "1.13.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@clack/prompts": "^1.8.1",
    "@dev-plugins/react-query": "^0.4.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/bun": "1.4.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "expo-atlas": "0.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "typescript": "~7.0.2",
    "ultracite": "7.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ]
      }
    }
  },
  "patchedDependencies": {
    "metro@0.87.1": "patches/metro@0.87.1.patch",
    "metro-runtime@0.87.1": "patches/metro-runtime@0.87.1.patch",
    "react-native-worklets@0.13.0": "patches/react-native-worklets@0.13.0.patch"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/test/jest-setup.ts"
    ],
    "watchman": false,
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "\\.css$": "<rootDir>/test/style-mock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|standard-navigation|@dev-plugins|uniwind|panelui-native|@rbayuokt))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
