{
  "name": "expo-base-uniwind",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "addons/*"
  ],
  "scripts": {
    "start": "bun --cwd apps/native start",
    "android": "bun --cwd apps/native android",
    "typecheck": "bun --cwd apps/native typecheck",
    "ios": "bun --cwd apps/native ios",
    "prebuild:all": "bun --cwd apps/native prebuild:all",
    "prebuild:android": "bun --cwd apps/native prebuild:android",
    "prebuild:ios": "bun --cwd apps/native prebuild:ios",
    "build:apk": "bun --cwd apps/native build:apk",
    "build:aab": "bun --cwd apps/native build:aab",
    "expo": "bun --cwd apps/native expo",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "addons:sentry": "bun --cwd addons/sentry setup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "lefthook": "^2.0.16",
    "ultracite": "7.1.1",
    "@packages/tsconfig": "workspace:*",
    "@typescript/native-preview": "catalog:"
  },
  "catalog": {
    "@sentry/react-native": "^8.8.0",
    "@types/react": "~19.2.2",
    "zustand": "5.0.12",
    "react-native": "0.85.3",
    "react": "19.2.3",
    "typescript": "~6.0.3",
    "react-native-notify-kit": "10.2.1",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260428.1"
  },
  "catalogs": {
    "expo-56": {
      "expo": "^56.0.5",
      "expo-router": "~56.2.7",
      "expo-constants": "~56.0.16",
      "expo-device": "~56.0.4",
      "expo-font": "~56.0.5",
      "expo-glass-effect": "~56.0.4",
      "expo-image": "~56.0.9",
      "expo-linking": "~56.0.12",
      "expo-localization": "~56.0.6",
      "expo-splash-screen": "~56.0.10",
      "expo-status-bar": "~56.0.4",
      "expo-system-ui": "~56.0.5",
      "expo-application": "~56.0.3",
      "expo-build-properties": "~56.0.15",
      "expo-haptics": "~56.0.3",
      "expo-blur": "~56.0.3",
      "babel-preset-expo": "~56.0.13",
      "@expo/ui": "~56.0.14"
    },
    "native": {
      "@react-navigation/elements": "^2.9.19 ",
      "@react-navigation/native": "^7.2.5",
      "react-native-safe-area-context": "~5.8.0",
      "react-native-screens": "~4.25.2",
      "react-native-gesture-handler": "~2.31.2",
      "react-native-keyboard-controller": "^1.21.8",
      "react-native-reanimated": "4.3.1",
      "react-native-worklets": "0.8.3",
      "react-native-nitro-modules": "^0.35.7",
      "react-native-mmkv": "4.3.1",
      "react-native-svg": "15.15.4"
    }
  }
}
