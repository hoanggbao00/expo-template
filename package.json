{
  "name": "expo-template",
  "androidVersion": "1.0.0",
  "androidVersionCode": 1,
  "iosVersion": "1.0.0",
  "iosBuildNumber": 1,
  "private": true,
  "main": "index.js",
  "author": {
    "name": "hoanggbao",
    "email": "hoanggbao00@gmail.com",
    "url": "https://github.com/hoanggbao00"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "prebuild:android": "expo prebuild --platform android --no-clean",
    "prebuild:android:clean": "expo prebuild --platform android",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --platform ios --no-clean",
    "prebuild:ios:prod": "APP_VARIANT=production expo prebuild --platform ios --no-clean",
    "prebuild:ios:clean": "APP_VARIANT=development expo prebuild --platform ios",
    "prebuild:ios:clean:prod": "APP_VARIANT=production expo prebuild --platform ios",
    "android": "./scripts/run-android.sh",
    "android:prod": "./scripts/run-android.sh --prod",
    "ios": "APP_VARIANT=development expo run:ios",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "prepare": "lefthook install",
    "build:apk": "./scripts/build-android.sh --apk",
    "build:aab": "./scripts/build-android.sh --aab",
    "atlas": "EXPO_ATLAS=true bun expo export --platform android && bunx expo-atlas .expo/atlas.jsonl"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~58.0.21",
    "@rbayuokt/expo-adaptive-status-bar": "^0.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.3",
    "panelui-native": "0.113.0",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-ease": "^0.9.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "^1.22.8",
    "react-native-mmkv": "^4.3.2",
    "react-native-nano-icons": "^1.0.1",
    "react-native-nitro-fetch": "^1.9.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-plain-text": "0.9.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@dev-plugins/react-query": "^0.4.0",
    "@types/bun": "^1.4.3",
    "@types/react": "~19.3.0",
    "expo-atlas": "^0.4.3",
    "lefthook": "^2.2.2",
    "typescript": "~7.0.2",
    "ultracite": "7.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ]
      }
    }
  },
  "patchedDependencies": {
    "metro@0.87.1": "patches/metro@0.87.1.patch",
    "metro-runtime@0.87.1": "patches/metro-runtime@0.87.1.patch",
    "react-native-worklets@0.13.0": "patches/react-native-worklets@0.13.0.patch"
  }
}
