{
  "name": "expo-template",
  "version": "1.0.0",
  "versionCode": 1,
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "bun tsgo --noEmit -p tsconfig.json",
    "prepare": "lefthook install",
    "build:apk": "./scripts/build-android.sh --apk",
    "build:aab": "./scripts/build-android.sh --aab"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~56.0.14",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "clsx": "^2.1.1",
    "expo": "^56.0.5",
    "expo-build-properties": "~56.0.15",
    "expo-constants": "~56.0.16",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.12",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.7",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "i18next": "^26.2.0",
    "pressto": "^0.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-ease": "^0.7.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "^1.21.7",
    "react-native-mmkv": "^4.3.1",
    "react-native-nano-icons": "^0.1.8",
    "react-native-nitro-fetch": "^1.3.1",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.1",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.6.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/react": "~19.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260519.1",
    "lefthook": "^2.1.8",
    "typescript": "~5.9.2",
    "ultracite": "7.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "react-native-reanimated"
      ]
    }
  }
}
