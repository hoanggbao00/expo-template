{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!src/uniwind-types.d.ts", "!.vscode", "!.*/skills"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noDuplicateCustomProperties": "off",
        "noConsole": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "panelui-native": "Import from a subpath (panelui-native/components/<slug>, panelui-native/utils/cn). Metro does not tree-shake the root entry."
            }
          }
        },
        "useFilenamingConvention": "off",
        "useBlockStatements": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noGlobalDirnameFilename": "off"
      },
      "nursery": {
        "noIncrementDecrement": "off"
      }
    }
  },
  "javascript": {
    "globals": ["__DEV__"]
  },
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120
  }
}
