{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "@addons/notify": ["../../addons/notify/src/index.ts"],
      "@addons/notify/*": ["../../addons/notify/src/*.ts"],
      "@packages/ui-kit": ["../../packages/ui-kit/src/index.ts"],
      "@packages/ui-kit/*": ["../../packages/ui-kit/src/*.ts"],
      "@packages/utils": ["../../packages/utils/src/index.ts"],
      "@packages/utils/*": ["../../packages/utils/src/*.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
