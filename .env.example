# Copy → .env.local (dev) or .env.production.local (prod build)
# Selects the dev/production branding (name/slug/bundle id/scheme) baked into
# app.config.ts at prebuild time — those identifiers stay in source, not here.

APP_VARIANT=development # development | production

# GRADLE_JVM_ARGS=-Xmx4096m -XX:MaxMetaspaceSize=1024m
# OBJDUMP=$HOME/Library/Android/sdk/ndk/.../llvm-objdump
